    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@velasia/contracts": "workspace:*",
    "fastify": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
