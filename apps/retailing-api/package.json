{
  "name": "@velasia/retailing-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Fastify mock of Velasia Airways' airline retailing API.",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:tool": "tsx src/tools/db-tool-cli.ts",
    "build": "node scripts/build.mjs",
    "start:prod": "node dist/server.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@taladb/node": "catalog:",
    "@velasia/contracts": "workspace:*",
    "@velasia/observability": "workspace:*",
    "fastify": "catalog:",
    "taladb": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@velasia/config": "workspace:*",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
