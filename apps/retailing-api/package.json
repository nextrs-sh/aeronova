{
  "name": "@velasia/retailing-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Fastify mock of AeroNova's airline retailing API.",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
