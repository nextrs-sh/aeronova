# Copy to .env (root) or apps/web/.env.local. All values have working local defaults.

# --- Retailing API (apps/retailing-api) ---
# Port and host the Fastify mock API listens on.
RETAILING_API_PORT=4010
RETAILING_API_HOST=127.0.0.1
# Seed for simulated demand, load factors, and cancellations (never schedules).
# The default keeps its pre-rebrand value so deterministic inventory is unchanged.
INVENTORY_SEED=aeronova
# Days of dated flights to publish from today (14–355).
INVENTORY_HORIZON_DAYS=120
# How long an offer can be selected before it must be re-priced, in minutes (1–120).
OFFER_VALIDITY_MINUTES=15
# Artificial latency on /v1/flights* and /v1/offers*, e.g. 400 or 200-900 (ms). Unset = none.
# RETAILING_API_LATENCY_MS=200-900
# Development/test only: honour the x-velasia-fault request header
# (delay=<ms> | timeout | unavailable | empty | malformed | slow-commit) and the
# x-velasia-scenario header (offer-expired | price-increase | sold-out | session-expired |
# seat-taken). `slow-commit` applies a change and then holds its answer (a lost response).
# RETAILING_API_FAULTS=enabled
# RETAILING_API_FAULT_TIMEOUT_MS=15000
# hold-expired is a further scenario (Milestone 5): orders read or paid in it expire.
# Test-only, needs RETAILING_API_FAULTS too: honour x-velasia-crash (kills the process with
# SIGKILL at a checkout boundary, for recovery tests).
# RETAILING_API_CRASH_TESTS=enabled

# Orders (Milestone 5). The TalaDB file this API process owns. One process per file: TalaDB
# locks it. Relative paths resolve from the API's working directory (apps/retailing-api).
# Reset (development): pnpm --filter @velasia/retailing-api db:reset --confirm
TALADB_PATH=./data/velasia.db
# How long checkout holds seats while waiting for payment, in minutes (1–60).
CHECKOUT_HOLD_MINUTES=10
# Payment attempts allowed per checkout (1–10). After the last decline the seats are released.
CHECKOUT_MAX_PAYMENT_ATTEMPTS=5
# How often held orders are checked for expiry (expiry is also checked on every access).
ORDER_SWEEP_INTERVAL_MS=30000
# Simulated payments. Let the tester choose the outcome (approve, decline, time out, pending).
# Default: enabled, except when NODE_ENV=production (then every demo payment is approved).
# PAYMENT_OUTCOME_CONTROLS=enabled
# Simulated provider latency, how long the API waits for it, and when a pending one resolves.
PAYMENT_PROVIDER_DELAY_MS=350
PAYMENT_PROVIDER_TIMEOUT_MS=2500
PAYMENT_PENDING_RESOLVE_MS=5000

# --- Storefront (apps/web) ---
# Server-side only: where the Next.js server reaches the retailing API.
# Never exposed to the browser — the browser talks to /api/* Route Handlers.
RETAILING_API_URL=http://127.0.0.1:4010
# Time budget per retailing API request (ms).
RETAILING_API_TIMEOUT_MS=5000
# Milestone 8 (API and storefront, same value): shared service token. Unset locally; required
# when the API is reachable outside a private network (see docs/deployment/).
# RETAILING_API_SERVICE_TOKEN=
# Canonical origin used for metadata, sitemap, and robots.
SITE_URL=http://localhost:3000
# Test-only: forward the velasia-fault and velasia-scenario cookies to the API as headers.
# RETAILING_API_FORWARD_FAULTS=enabled

# --- Both ---
# Pin "today" (YYYY-MM-DD, Asia/Manila) for deterministic demos and tests.
# Set it for the API and the storefront together. The E2E suite uses 2026-12-01.
# VELASIA_TODAY=2026-12-01
