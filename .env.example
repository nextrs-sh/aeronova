# Copy to .env (root) or apps/web/.env.local. All values have working local defaults.

# --- Retailing API (apps/retailing-api) ---
# Port and host the Fastify mock API listens on.
RETAILING_API_PORT=4010
RETAILING_API_HOST=127.0.0.1
# Seed for simulated demand, load factors, and cancellations (never schedules).
# The default keeps its pre-rebrand value so deterministic inventory is unchanged.
INVENTORY_SEED=aeronova
# Days of dated flights to publish from today (14–355).
INVENTORY_HORIZON_DAYS=120
# How long an offer can be selected before it must be re-priced, in minutes (1–120).
OFFER_VALIDITY_MINUTES=15
# Artificial latency on /v1/flights* and /v1/offers*, e.g. 400 or 200-900 (ms). Unset = none.
# RETAILING_API_LATENCY_MS=200-900
# Development/test only: honour the x-velasia-fault request header
# (delay=<ms> | timeout | unavailable | empty | malformed) and the x-velasia-scenario
# header (offer-expired | price-increase | sold-out | session-expired).
# RETAILING_API_FAULTS=enabled
# RETAILING_API_FAULT_TIMEOUT_MS=15000

# --- Storefront (apps/web) ---
# Server-side only: where the Next.js server reaches the retailing API.
# Never exposed to the browser — the browser talks to /api/* Route Handlers.
RETAILING_API_URL=http://127.0.0.1:4010
# Time budget per retailing API request (ms).
RETAILING_API_TIMEOUT_MS=5000
# Canonical origin used for metadata, sitemap, and robots.
SITE_URL=http://localhost:3000
# Test-only: forward the velasia-fault and velasia-scenario cookies to the API as headers.
# RETAILING_API_FORWARD_FAULTS=enabled

# --- Both ---
# Pin "today" (YYYY-MM-DD, Asia/Manila) for deterministic demos and tests.
# Set it for the API and the storefront together. The E2E suite uses 2026-12-01.
# VELASIA_TODAY=2026-12-01
