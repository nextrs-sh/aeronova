# syntax=docker/dockerfile:1.10
#
# Velasia Airways — Next.js storefront. Milestone 7.
#
#   docker build -f docker/Dockerfile.web -t velasia-web \
#     --build-arg SITE_URL=http://localhost:8080 .
#
# - `next build` with `output: 'standalone'`: the runtime image runs the same Next.js server as
#   `next start` (Cache Components, Partial Prerendering, Server Actions, image optimisation)
#   from `.next/standalone`, with only the traced production files.
# - Destination pages are prerendered from the retailing API at build time, so the build stage
#   starts a throwaway API on a temporary TalaDB file (apps/web/scripts/with-retailing-api.mjs).
#   No database or `.env` file ever enters the image.
# - Runs as the unprivileged `node` user. Only `.next/cache` (optimised images, fetch cache) is
#   written at runtime; revalidated pages stay in memory (`isrFlushToDisk: false`).
#
# Build arguments (all public; never pass secrets as build arguments):
#   SITE_URL               canonical origin baked into the sitemap/robots/metadata
#   VELASIA_DEPLOYMENT_ID  version-skew protection id (e.g. the git commit); optional
#   VELASIA_TODAY          pin "today" for deterministic demo/benchmark builds; optional
# Secret (optional, BuildKit): `--secret id=next_actions_key,env=NEXT_SERVER_ACTIONS_ENCRYPTION_KEY`
#   keeps Server Action encryption stable across builds (needed only for several web replicas
#   built separately; see docs/DEPLOYMENT.md).

ARG NODE_IMAGE=node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm \
    CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo

# ---------------------------------------------------------------------------
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/retailing-api/package.json apps/retailing-api/
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/observability/package.json packages/observability/
COPY packages/ui/package.json packages/ui/
RUN --mount=type=cache,id=velasia-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@velasia/web..." --filter "@velasia/retailing-api..."
COPY packages packages
COPY apps/retailing-api apps/retailing-api
COPY apps/web apps/web
ARG SITE_URL=http://localhost:8080
ARG VELASIA_DEPLOYMENT_ID=
ARG VELASIA_TODAY=
ENV SITE_URL=${SITE_URL} \
    VELASIA_DEPLOYMENT_ID=${VELASIA_DEPLOYMENT_ID} \
    VELASIA_TODAY=${VELASIA_TODAY}
RUN --mount=type=secret,id=next_actions_key,env=NEXT_SERVER_ACTIONS_ENCRYPTION_KEY \
    pnpm --filter @velasia/web build
# The build-time API wrote only to a temporary directory; make sure nothing else leaked in.
RUN test -f apps/web/.next/standalone/apps/web/server.js \
 && ! find apps/web/.next/standalone -name '*.db' -o -name '.env*' | grep -q .

# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
LABEL org.opencontainers.image.title="velasia-web" \
      org.opencontainers.image.description="Velasia Airways storefront (fictional demo; no real reservations or payments)" \
      org.opencontainers.image.source="https://github.com/nextrs-sh/velasia-airways" \
      org.opencontainers.image.licenses="MIT"
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg
# Application files belong to root (read-only for `node`); only the cache is writable.
COPY --from=build /repo/apps/web/.next/standalone ./
RUN mkdir -p apps/web/.next/cache && chown node:node apps/web/.next/cache
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/internal/health/live').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
STOPSIGNAL SIGTERM
CMD ["node", "apps/web/server.js"]
