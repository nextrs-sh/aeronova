# Velasia Airways — production-mode configuration template (Milestone 7).
#
#   cp .env.production.example .env.production
#
# `.env.production` is git-ignored and never copied into an image (.dockerignore). It is read
# by compose.yaml (`env_file`) for both the storefront and the retailing API; variables a
# service doesn't know are ignored by it. Everything here is server-side: nothing is exposed to
# the browser, and no variable uses the NEXT_PUBLIC_ prefix.
#
# Velasia Airways is fictional. No setting here enables real reservations or payments.

# --- Public origin (build arg and runtime) -----------------------------------------------
# The canonical origin browsers use. Baked into the sitemap/robots/metadata at build time and
# used at runtime for the Secure cookie flag (https:// ⇒ Secure cookies).
SITE_URL=http://localhost:8080
# Version-skew protection for rolling deploys (build arg). Use the git commit.
# VELASIA_DEPLOYMENT_ID=

# --- Published port (compose only) -------------------------------------------------------
# Bind to 127.0.0.1 unless a TLS-terminating proxy or load balancer sits in front.
VELASIA_HTTP_BIND=127.0.0.1
VELASIA_HTTP_PORT=8080
VELASIA_TAG=local

# --- Edge rate limits (nginx, per client address) ----------------------------------------
VELASIA_RATE_LIMIT_RPS=50
VELASIA_RATE_LIMIT_BURST=100
VELASIA_POST_RATE_LIMIT_RPS=10
VELASIA_POST_RATE_LIMIT_BURST=30

# --- Retailing API ------------------------------------------------------------------------
# Fixed by compose.yaml: NODE_ENV=production, TALADB_PATH=/data/velasia.db, host/port.
LOG_LEVEL=info
# Optional bearer token for GET /metrics (API) and /api/internal/metrics (storefront), both on
# the internal network only. 16+ characters; generate with `openssl rand -base64 32`.
# METRICS_TOKEN=
# Seed for deterministic demo inventory and prices (changing it reshuffles both).
INVENTORY_SEED=aeronova
INVENTORY_HORIZON_DAYS=120
OFFER_VALIDITY_MINUTES=15
CHECKOUT_HOLD_MINUTES=10
CHECKOUT_MAX_PAYMENT_ATTEMPTS=5
ORDER_SWEEP_INTERVAL_MS=30000
SERVICING_CLAIM_MINUTES=10
SHUTDOWN_TIMEOUT_MS=10000
SLOW_REQUEST_MS=1000

# Demo accounts have no email verification or password recovery: self-service registration
# stays closed on a public deployment. Enable only for a private demonstration.
ACCOUNT_REGISTRATION=disabled
# Let testers choose simulated payment outcomes (decline, timeout, pending). Off in production:
# every simulated payment is approved.
PAYMENT_OUTCOME_CONTROLS=disabled
PAYMENT_PROVIDER_DELAY_MS=350
PAYMENT_PROVIDER_TIMEOUT_MS=2500
PAYMENT_PENDING_RESOLVE_MS=5000

# Test-only fault injection is refused in production unless VELASIA_ALLOW_TEST_CONTROLS is
# also enabled. Never enable these on a reachable deployment.
# RETAILING_API_FAULTS=disabled
# RETAILING_API_CRASH_TESTS=disabled
# RETAILING_API_FORWARD_FAULTS=disabled
# VELASIA_ALLOW_TEST_CONTROLS=disabled

# --- Storefront ----------------------------------------------------------------------------
# Fixed by compose.yaml: RETAILING_API_URL=http://velasia-api:4010.
RETAILING_API_TIMEOUT_MS=5000

# --- Deterministic demos and benchmarks only ----------------------------------------------
# Pin "today" (Asia/Manila) for the API and the storefront together (and as a build arg).
# VELASIA_TODAY=2026-12-01
